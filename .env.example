# Base URL for the OpenSky CORS proxy. Leave unset for local dev — Vite's
# dev server proxy (see vite.config.ts) handles it automatically.
# For a production build (e.g. GitHub Pages), point this at the deployed
# Cloudflare Worker from cloudflare-worker/ instead:
# VITE_OPENSKY_PROXY_URL=https://ops-opensky-proxy.<your-subdomain>.workers.dev
